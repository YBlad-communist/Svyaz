__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local scratch / dev scripts
_check*.py
_test*.py
_verify*.py
_final_check.py
start_dev.bat
inventory

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
